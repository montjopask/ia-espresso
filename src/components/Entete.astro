---
import Tasse from './Tasse.astro';
import { lien } from '../lib/crus';

interface Props {
  rubrique?: string;
}
const { rubrique } = Astro.props;
const liens = [
  { cle: 'archives', texte: 'Archives', href: lien('/archives/') },
  { cle: 'themes', texte: 'Thèmes', href: lien('/themes/') },
  { cle: 'recherche', texte: 'Recherche', href: lien('/recherche/') },
  { cle: 'a-propos', texte: 'À propos', href: lien('/a-propos/') },
];
---
<header class="entete">
  <a class="marque" href={lien('/')} aria-label="IA Espresso, accueil">
    <Tasse />
    <span>
      <span class="marque-nom"><span class="ia">IA</span> <span class="esp">Espresso</span></span>
      <span class="devise">Ta dose quotidienne, sans le scroll</span>
    </span>
  </a>
  <nav class="nav" aria-label="Navigation principale">
    {liens.map((l) => (
      <a href={l.href} aria-current={rubrique === l.cle ? 'page' : undefined}>{l.texte}</a>
    ))}
  </nav>
  <button class="bouton-theme" type="button" data-bouton-theme aria-label="Passer au thème clair">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
    </svg>
  </button>
</header>
