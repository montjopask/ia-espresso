---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/encode-sans/standard.css';
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import { lien } from '../lib/crus';

interface Props {
  titre: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonld?: Record<string, unknown>;
  rubrique?: string;
}

const { titre, description, image = lien('/og/accueil.png'), type = 'website', jsonld, rubrique } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site);
const imageAbsolue = new URL(image, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href={lien('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="IA Espresso" href={lien('/rss.xml')} />
    <meta name="theme-color" content="#121016" />

    <meta property="og:site_name" content="IA Espresso" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}

    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <div class="page">
      <Entete rubrique={rubrique} />
      <main id="contenu">
        <slot />
      </main>
      <Pied />
    </div>
    <script>
      const bouton = document.querySelector<HTMLButtonElement>('[data-bouton-theme]');
      const racine = document.documentElement;
      const etiquette = () => {
        const clair = racine.dataset.theme === 'light';
        bouton?.setAttribute('aria-label', clair ? 'Passer au thème sombre' : 'Passer au thème clair');
        bouton?.setAttribute('aria-pressed', String(clair));
      };
      etiquette();
      bouton?.addEventListener('click', () => {
        const clair = racine.dataset.theme !== 'light';
        if (clair) racine.dataset.theme = 'light';
        else delete racine.dataset.theme;
        try {
          if (clair) localStorage.setItem('theme', 'light');
          else localStorage.removeItem('theme');
        } catch (e) {}
        etiquette();
      });
    </script>
  </body>
</html>
